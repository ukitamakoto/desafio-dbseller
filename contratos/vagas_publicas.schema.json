{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GET /api/v2/recruitment/public/vacancies (sem autenticação)",
  "description": "additionalProperties=false nos itens: a API pública não pode expor campos além destes (ex.: hiring manager).",
  "type": "object",
  "required": ["data", "meta", "rels"],
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "numOfPositions", "status", "isPublished"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "integer", "minimum": 1},
          "name": {"type": "string", "minLength": 1},
          "description": {"type": ["string", "null"]},
          "numOfPositions": {"type": ["integer", "null"], "minimum": 0},
          "status": {"type": "boolean"},
          "isPublished": {"type": "boolean"}
        }
      }
    },
    "meta": {
      "type": "object",
      "required": ["total"],
      "properties": {"total": {"type": "integer", "minimum": 0}}
    },
    "rels": {"type": "array"}
  }
}
