{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GET /api/v2/recruitment/candidates?model=list (Admin)",
  "type": "object",
  "required": ["data", "meta"],
  "$defs": {
    "pessoa": {
      "type": "object",
      "required": ["id", "firstName", "lastName"],
      "properties": {
        "id": {"type": ["integer", "null"]},
        "firstName": {"type": ["string", "null"]},
        "middleName": {"type": ["string", "null"]},
        "lastName": {"type": ["string", "null"]}
      }
    }
  },
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "firstName", "lastName", "dateOfApplication", "vacancy", "status", "hasAttachment"],
        "properties": {
          "id": {"type": "integer", "minimum": 1},
          "firstName": {"type": "string", "minLength": 1},
          "middleName": {"type": ["string", "null"]},
          "lastName": {"type": "string", "minLength": 1},
          "dateOfApplication": {"type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "vacancy": {
            "type": ["object", "null"],
            "required": ["id", "name", "status", "hiringManager"],
            "properties": {
              "id": {"type": "integer"},
              "name": {"type": "string"},
              "status": {"type": "boolean"},
              "hiringManager": {"$ref": "#/$defs/pessoa"}
            }
          },
          "status": {
            "type": ["object", "null"],
            "required": ["id", "label"],
            "properties": {
              "id": {"type": "integer"},
              "label": {
                "enum": ["Application Initiated", "Shortlisted", "Rejected", "Interview Scheduled", "Interview Passed",
                         "Interview Failed", "Job Offered", "Offer Declined", "Hired"]
              }
            }
          },
          "hasAttachment": {"type": "boolean"}
        }
      }
    },
    "meta": {
      "type": "object",
      "required": ["total"],
      "properties": {"total": {"type": "integer", "minimum": 0}}
    }
  }
}
